# ── Required ───────────────────────────────────────────────────────────────────

# OpenRouter API Key – get free at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pinecone API Key – get free at https://pinecone.io (Starter plan)
PINECONE_API_KEY=your_pinecone_api_key_here

# ── Optional (defaults shown) ──────────────────────────────────────────────────

# Pinecone index name (created automatically on first run)
PINECONE_INDEX_NAME=real-estate

# Max listing pages per scraper source (lower = faster, less data)
SCRAPE_MAX_PAGES=5

# Backend URL exposed to the frontend browser bundle
NEXT_PUBLIC_API_URL=http://localhost:8080

# App identity shown in your OpenRouter dashboard
# Set APP_URL to your deployed URL in production
APP_URL=http://localhost:3000
APP_TITLE=Real Estate AI Chatbot
