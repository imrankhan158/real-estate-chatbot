# OpenRouter API Key (get free at https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# App identity shown in your OpenRouter dashboard (set to your deployed URL in production)
APP_URL=http://localhost:3000
APP_TITLE=Real Estate AI Chatbot

# Scraper limits (reduce for faster dev/test)
SCRAPE_MAX_PAGES=5

# ChromaDB
CHROMA_HOST=vectordb
CHROMA_PORT=8000

# Frontend API URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
